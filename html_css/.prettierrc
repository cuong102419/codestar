{
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "endOfLine": "lf",

    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "bracketSameLine": true,
    "arrowParens": "always",

    "htmlWhitespaceSensitivity": "ignore",
    "bracketSpacing": false,
    "singleAttributePerLine": false
}